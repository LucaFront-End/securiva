{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/samples/securiva-informe-demostracion.txt",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"SECURIVA_Informe_Demostracion.txt\"" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [ { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }, { "key": "X-Robots-Tag", "value": "noindex, follow" } ]
    },
    {
      "source": "/content-index.json",
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex, follow" } ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
